FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    openbabel \
    libopenbabel-dev \
    && rm -rf /var/lib/apt/lists/*

# Install AutoDock Vina binary
RUN wget -q https://github.com/ccsb-scripps/AutoDock-Vina/releases/download/v1.2.5/vina_1.2.5_linux_x86_64 \
    -O /usr/local/bin/vina && chmod +x /usr/local/bin/vina

WORKDIR /app

# Install Python dependencies first (layer caching)
COPY requirements.txt ./
RUN pip3 install --no-cache-dir -r requirements.txt

# Copy application code
COPY api/ ./api/

# Persistent data directory (map to CapRover persistent storage)
RUN mkdir -p /app/data
ENV LCBC_DB_PATH=/app/data/lcbc_dock.db
ENV VINA_PATH=/usr/local/bin/vina

EXPOSE 8000

CMD ["uvicorn", "--host=0.0.0.0", "--port=8000", "api.index:app", "--workers=1"]
