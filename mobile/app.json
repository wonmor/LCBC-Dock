{
  "expo": {
    "name": "DockIt",
    "slug": "dockit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dockit",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.johnseong.dock-it",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.johnseong.dock_it",
      "kotlinVersion": "1.9.25"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      ["./plugins/withKotlinVersion", "1.9.25"]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8c21fe13-436b-44fc-8eb6-9623561528be"
      }
    }
  }
}
